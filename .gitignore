# Python build and cache files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Secrets: never commit real API keys. .env.example (added later) is the template.
.env
.env.*
!.env.example

# Large media and model files stay out of git
*.mp3
*.wav
*.m4a
*.flac
*.ogg
*.mp4
*.webm
*.bin
*.pt
*.pth
*.safetensors
*.onnx
*.gguf
models/
data/raw/
data/audio/
# Fine-tuning clips and their labels are generated from data/raw (Step 6.1)
data/finetune/

# Notebooks checkpoints and OS / editor clutter
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Generated transcripts, notes, and flashcards (NOTETAKER_OUTPUT_DIR default)
outputs/

# Search indexes are generated from transcripts (vectorstore.py); rebuild them
# instead of committing them.
index/
*.faiss
