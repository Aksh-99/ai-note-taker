# Copy this file to `.env` and edit the values you want to change:
#     cp .env.example .env
# `.env` is gitignored, so real API keys never get committed. Every line is
# optional: anything left out uses the default shown here.
# Run `notetaker config` to see the values the app actually picked up.

# ---- Paths -------------------------------------------------------------
# Downloaded lectures and evaluation data (gitignored).
NOTETAKER_DATA_DIR=data
# Where transcripts, notes, and flashcards are written.
NOTETAKER_OUTPUT_DIR=outputs

# ---- Transcription (faster-whisper, runs locally, free) ----------------
# One of: tiny, base, small, medium, large-v3. Bigger = more accurate, slower.
NOTETAKER_WHISPER_MODEL=small
# One of: auto, cpu, cuda. auto picks a GPU when one is available.
NOTETAKER_WHISPER_DEVICE=auto
# One of: auto, int8, float16, float32. int8 is fastest on CPU.
NOTETAKER_WHISPER_COMPUTE_TYPE=auto
# Spoken language code (en, es, ...). Leave blank to auto-detect.
NOTETAKER_LANGUAGE=en
# Audio is resampled to this rate in Hz. Whisper expects 16000.
NOTETAKER_SAMPLE_RATE=16000
# Long recordings are split at pauses into pieces of at most this many
# seconds, so a 90-minute lecture never goes to Whisper in one call. 0 = off.
NOTETAKER_CHUNK_MAX_SECONDS=300

# ---- Notes generation (LLM) --------------------------------------------
# One of: ollama (local, free), groq (free tier), huggingface (free tier).
NOTETAKER_LLM_PROVIDER=ollama
# Model name as the provider spells it, e.g. llama3.1:8b for Ollama.
NOTETAKER_LLM_MODEL=llama3.1:8b
# 0.0 to 2.0. Lower = more consistent notes.
NOTETAKER_LLM_TEMPERATURE=0.2
# Address of your local Ollama server.
NOTETAKER_OLLAMA_BASE_URL=http://localhost:11434
# Free-tier keys, only needed for hosted providers. Never commit real values.
# GROQ_API_KEY and HF_TOKEN (without the prefix) also work.
NOTETAKER_GROQ_API_KEY=
NOTETAKER_HF_TOKEN=

# ---- Search across lectures (RAG) --------------------------------------
# Small free sentence-transformers model used for embeddings.
NOTETAKER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
